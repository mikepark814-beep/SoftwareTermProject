<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toggle Button for Chips -->
    <ImageButton
        android:id="@+id/btnToggleChips"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/colorSurface"
        android:src="@android:drawable/arrow_up_float"
        android:scaleType="centerInside"
        android:contentDescription="Toggle chips visibility" />

    <!-- Category chips -->
    <HorizontalScrollView
        android:id="@+id/chipGroupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_hospital"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_pharmacy"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGovernment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_government"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRestaurant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_restaurant"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSubway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_subway"
                style="@style/Widget.Material3.Chip.Filter" />

            <!-- Newly added important POI chips -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipHotel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotel"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPolice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Police"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shops"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Map (takes 60% of height) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPlaceTypes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_gravity="start|top"
            android:contentDescription="Place types"
            android:src="@android:drawable/ic_menu_more" />

        <!-- Radius Slider -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvRadius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Radius: 1.5 km"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="50.0"
                    android:stepSize="0.5"
                    android:value="1.5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Toggle Button for List -->
    <ImageButton
        android:id="@+id/btnToggleList"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/colorSurface"
        android:src="@android:drawable/arrow_down_float"
        android:scaleType="centerInside"
        android:contentDescription="Toggle list visibility" />

    <!-- Place list (takes 40% of height) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaces"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/colorSurface" />

</LinearLayout>
